{
  "name": "filter_ui",
  "version": "0.2.17",
  "description": "UI to filter anything",
  "scripts": {
    "build": "tsc && node scripts/build-renderer.mjs",
    "exe": "electron-builder",
    "lint": "eslint src tests",
    "start": "electron --inspect ./js/Infrastructure/main_app.js",
    "build-n-start": "npm run build && npm run start",
    "postinstall": "electron-builder install-app-deps",
    "publish": "electron-builder build --publish onTagOrDraft",
    "before-publish": "npm ci && npm run build && npm test",
    "test": "npm run build && node --test js/Infrastructure/Electron/Main/Path.test.js && playwright test"
  },
  "main": "./js/Infrastructure/main_app.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/zored/filter_ui"
  },
  "keywords": [
    "filter",
    "ui",
    "electron",
    "typescript"
  ],
  "author": "zored",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/object-hash": "^3.0.6",
    "@types/semver": "^7.8.0",
    "@types/yargs": "^17.0.35",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "object-hash": "^3.0.0",
    "sharp": "^0.35.3",
    "yargs": "^18.1.0"
  }
}
